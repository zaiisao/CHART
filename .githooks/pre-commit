#!/bin/sh
# Enforce ruff.toml on every commit. Enable once per clone:
#   git config core.hooksPath .githooks
# Needs ruff on PATH or importable (pip install ruff).

if command -v ruff >/dev/null 2>&1; then
    RUFF=ruff
elif [ -x /tmp/lint/bin/ruff ]; then
    RUFF=/tmp/lint/bin/ruff
else
    echo "pre-commit: ruff not found (pip install ruff) -- refusing to commit unchecked" >&2
    exit 1
fi

# lint only TRACKED python files: the working dir still holds untracked v1 leftovers,
# which are not part of the repo and not this hook's business
git ls-files -z '*.py' | xargs -0 $RUFF check || {
    echo "pre-commit: style violations (see above). Fix or 'git commit --no-verify' with cause." >&2
    exit 1
}
